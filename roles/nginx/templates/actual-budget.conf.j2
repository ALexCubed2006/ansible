{% set _budget_acl = budget_allowed_ips | default([]) %}

server {
    listen 80;
    server_name {{ budget_server_name }};

    {% if _budget_acl | length > 0 %}
    {% for ip in _budget_acl %}
        allow {{ ip }};
    {% endfor %}
        deny all;
    {% endif %}

    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ budget_server_name }};

    ssl_certificate     {{ nginx_pub_crt }};
    ssl_certificate_key {{ nginx_privkey }};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    client_max_body_size 50m;

    {% if _budget_acl | length > 0 %}
    {% for ip in _budget_acl %}
        allow {{ ip }};
    {% endfor %}
        deny all;
    {% endif %}

    location / {
        proxy_pass http://127.0.0.1:{{ actual_port }};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}